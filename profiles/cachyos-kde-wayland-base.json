{
  "schema_version": 1,
  "id": "cachyos-kde-wayland-base",
  "title": "Base profissional CachyOS, KDE Plasma 6 e Wayland",
  "description": "Perfil inicial de referência da ASTOM Platform. Este manifesto apenas diagnostica e planeja; nenhuma instalação é executada.",
  "target": {
    "distribution_ids": ["cachyos"],
    "desktop_contains": ["kde", "plasma"],
    "session_types": ["wayland"],
    "root_filesystems": ["btrfs"]
  },
  "components": [
    {
      "id": "cap-bash",
      "type": "command",
      "command": "bash",
      "category": "core",
      "description": "Interpretador Bash disponível no PATH",
      "required": true,
      "when_missing": "revisar o ambiente base; a ASTOM requer Bash"
    },
    {
      "id": "pkg-bash",
      "type": "package",
      "manager": "pacman",
      "package": "bash",
      "category": "core",
      "description": "Pacote Bash fornecido pelo repositório da distribuição",
      "required": true,
      "when_missing": "revisar a integridade da instalação base"
    },
    {
      "id": "cap-python3",
      "type": "command",
      "command": "python3",
      "category": "core",
      "description": "Runtime Python 3 disponível no PATH",
      "required": true,
      "when_missing": "instalar Python 3 pelo gerenciador oficial após confirmação"
    },
    {
      "id": "pkg-python",
      "type": "package",
      "manager": "pacman",
      "package": "python",
      "category": "core",
      "description": "Pacote Python da distribuição",
      "required": true,
      "when_missing": "planejar instalação do pacote python"
    },
    {
      "id": "cap-git",
      "type": "command",
      "command": "git",
      "category": "desenvolvimento",
      "description": "Controle de versão Git disponível no PATH",
      "required": true,
      "when_missing": "instalar Git pelo gerenciador oficial após confirmação"
    },
    {
      "id": "pkg-git",
      "type": "package",
      "manager": "pacman",
      "package": "git",
      "category": "desenvolvimento",
      "description": "Pacote Git da distribuição",
      "required": true,
      "when_missing": "planejar instalação do pacote git"
    },
    {
      "id": "cap-findmnt",
      "type": "command",
      "command": "findmnt",
      "category": "diagnóstico",
      "description": "Consulta segura de pontos de montagem",
      "required": true,
      "when_missing": "revisar o pacote util-linux"
    },
    {
      "id": "pkg-util-linux",
      "type": "package",
      "manager": "pacman",
      "package": "util-linux",
      "category": "diagnóstico",
      "description": "Ferramentas base de sistema, incluindo findmnt",
      "required": true,
      "when_missing": "revisar a integridade da instalação base"
    },
    {
      "id": "cap-systemctl",
      "type": "command",
      "command": "systemctl",
      "category": "sistema",
      "description": "Consulta de unidades systemd",
      "required": true,
      "when_missing": "revisar compatibilidade; o perfil de referência requer systemd"
    },
    {
      "id": "pkg-systemd",
      "type": "package",
      "manager": "pacman",
      "package": "systemd",
      "category": "sistema",
      "description": "Pacote systemd da distribuição",
      "required": true,
      "when_missing": "revisar a integridade da instalação base"
    },
    {
      "id": "cap-snapper",
      "type": "command",
      "command": "snapper",
      "category": "recuperação",
      "description": "Gerenciamento de snapshots Btrfs",
      "required": true,
      "when_missing": "planejar instalação e configuração do Snapper antes de qualquer implantação"
    },
    {
      "id": "pkg-snapper",
      "type": "package",
      "manager": "pacman",
      "package": "snapper",
      "category": "recuperação",
      "description": "Pacote Snapper da distribuição",
      "required": true,
      "when_missing": "bloquear a futura implantação até o Snapper ser revisado"
    },
    {
      "id": "cap-bootctl",
      "type": "command",
      "command": "bootctl",
      "category": "inicialização",
      "description": "Consulta do systemd-boot",
      "required": false,
      "when_missing": "nenhuma; manter suporte a outros mecanismos de inicialização"
    },
    {
      "id": "pkg-flatpak",
      "type": "package",
      "manager": "pacman",
      "package": "flatpak",
      "category": "aplicativos",
      "description": "Runtime de aplicações Flatpak",
      "required": false,
      "when_missing": "oferecer como módulo opcional após confirmação"
    },
    {
      "id": "flatpak-bitwarden",
      "type": "flatpak",
      "app_id": "com.bitwarden.desktop",
      "category": "segurança",
      "description": "Cliente Bitwarden Desktop via Flatpak",
      "required": false,
      "when_missing": "nenhuma; aplicativo opcional"
    },
    {
      "id": "pkg-ufw",
      "type": "package",
      "manager": "pacman",
      "package": "ufw",
      "category": "segurança",
      "description": "Interface de firewall UFW",
      "required": false,
      "when_missing": "avaliar o firewall ativo antes de recomendar instalação"
    },
    {
      "id": "pkg-steam",
      "type": "package",
      "manager": "pacman",
      "package": "steam",
      "category": "jogos",
      "description": "Cliente Steam",
      "required": false,
      "when_missing": "nenhuma; componente exclusivo do perfil opcional de jogos"
    }
  ]
}
